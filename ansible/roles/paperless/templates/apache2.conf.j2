<VirtualHost *:80>
    ServerName paperless.barmin-home.local

    ProxyPreserveHost On
    ProxyRequests Off

    ProxyPass / http://127.0.0.1:28000/
    ProxyPassReverse / http://127.0.0.1:28000/

    CustomLog /var/log/apache2/paperless_access.log combined
    ErrorLog /var/log/apache2/paperless_error.log
</VirtualHost>
